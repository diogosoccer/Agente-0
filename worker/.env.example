# Local JARVIS desktop configuration
PORT=8787
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Keep write actions disabled until explicitly enabled.
JARVIS_ALLOW_WRITES=0

# Optional local identity settings
JARVIS_IDENTITY_ENABLED=0
JARVIS_IDENTITY_PROVIDER=local

# Optional future integrations
JARVIS_EMAIL_ENABLED=0
JARVIS_MEMORY_PATH=./data/memory
