{
  "name": "agente-zero",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop": "npm --prefix desktop start",
    "desktop:install": "npm --prefix desktop install",
    "desktop:build": "npm run build",
    "desktop:package": "npm run build && npm --prefix desktop install && npm --prefix desktop run build",
    "test:contracts": "node scripts/validate-contracts.mjs",
    "verify": "npm run build && npm run test:contracts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "@supabase/supabase-js": "2.117.2"
  },
  "devDependencies": {
    "typescript": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "vite": "latest",
    "tailwindcss": "latest",
    "@tailwindcss/vite": "latest",
    "shadcn": "latest"
  }
}
